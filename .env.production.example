# Public hostname. Use api.example.com in production; Caddy enables HTTPS.
CADDY_ADDRESS=api.example.com
PUBLIC_BASE_URL=https://api.example.com
HTTP_PORT=80
HTTPS_PORT=443

DB_NAME=local_offers
DB_USER=local_offers
# Use a strong URL-safe value because this is also interpolated into the migration URL.
DB_PASSWORD=replace-with-a-strong-url-safe-password
JWT_SECRET=replace-with-a-strong-independent-secret
